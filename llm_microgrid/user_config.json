{
  "llm": {
    "enabled": false,
    "api_key": "your api key",
    "model": "gemini-2.5-flash",
    "max_tokens": 2000,
    "policy_description": "Encourage renewable energy usage (wind/solar) with positive rewards. Penalize diesel generator use based on fuel consumption. Reward battery for balancing supply-demand. Incentivize customer demand response."
  },
  "experiment": {
    "exp_name": "debug_maddpg",
    "save_dir": "checkpoints",
    "log_dir": "logs",
    "plot_dir": "plots"
  },
  "environment": {
    "num_envs": 2,
    "max_steps": 24
  },
  "training": {
    "total_episodes": 20,
    "batch_size": 128,
    "warmup_episodes": 20,
    "actor_lr": 5e-5,
    "critic_lr": 5e-4,
    "gamma": 0.95,
    "tau": 0.01,
    "buffer_capacity": 50000
  },
  "exploration": {
    "noise_scale": 0.3,
    "noise_decay": 0.996,
    "noise_min": 0.02
  },
  "logging": {
    "log_interval": 1,
    "plot_interval": 20,
    "save_interval": 100
  }
}